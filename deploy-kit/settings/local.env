# ==================================================================== LOCAL TEST CHAIN SETTINGS
# Used by npm run dev and npm test. Committed: no secrets here.

# Ports of the local node for npm run dev, and a separate one for npm test
LOCAL_PORT=8645
TEST_PORT=8647

# Chain id of the local chain (your wallet adds it as a new network)
LOCAL_CHAIN_ID=31338

# How often a block closes while transactions wait, in ms (npm run dev feels like the real chain; npm test runs fast)
LOCAL_BLOCK_MS=500
TEST_BLOCK_MS=60

# Name and symbol of the native coin the wallet shows for the local chain
LOCAL_COIN_NAME=BWSC Local
LOCAL_COIN_SYMBOL=tBWSC

# Coins each test key starts with in the local genesis (whole coins)
LOCAL_GENESIS_BALANCE=1000000

# Sample people created when npm run dev starts
LOCAL_SEED=12

# Extra delay per read in milliseconds ("min-max"), so the local site feels like a public node. 0 = off
LOCAL_RPC_LATENCY=120-380

# What the test panel's buttons give: native coins for gas, and whole tokens of each token
LOCAL_FUND_GAS=10
LOCAL_FUND_AMOUNT=1000

# People funded for npm test (t.newWallet())
TEST_PEOPLE=20

# npm run test:app: port of the website under test, and how many sample people the chain gets first
APP_TEST_PORT=5199
APP_TEST_SEED=6

# Bridge: the local BSC (anvil from Foundry; not installed = the bridge has no BSC side locally) and the bridge signer
LOCAL_BSC_PORT=8655
TEST_BSC_PORT=8657
APP_TEST_BSC_PORT=8659
LOCAL_BSC_CHAIN_ID=31337
# A second EVM chain (anvil), so the bridge is always tested with more than one chain
LOCAL_CHAIN2_PORT=8661
APP_TEST_CHAIN2_PORT=8663
LOCAL_CHAIN2_ID=31339
LOCAL_SIGNER_PORT=8790
APP_TEST_SIGNER_PORT=8792

# Staking on the local chains: every pool from settings/stake-pools gets one reward stream (whole tokens over days)
LOCAL_STAKE_REWARD=10000
LOCAL_STAKE_DAYS=30
