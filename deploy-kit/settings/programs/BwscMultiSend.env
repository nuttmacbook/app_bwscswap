# ==================================================================== BwscMultiSend (deploy-kit/bwsc/BwscMultiSend.js)
# Send a coin (native or token) to many wallets in one transaction. No owner, no fee, nothing to set.

# Name shown in the explorer (unique on the whole chain)
NAMESPACE=bwsc-multisend

# One line for the explorer
DESCRIPTION=BWSC multi transfer: send the native coin or a token to many wallets in one transaction
