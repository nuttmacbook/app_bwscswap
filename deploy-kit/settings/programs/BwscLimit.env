# ==================================================================== BwscLimit (deploy-kit/bwsc/BwscLimit.js)
# Limit orders: coin for coin at the maker's price. On the test chain it starts with the native coin, USDT and wBWSC
# listed, each with FEE_BPS; more coins come from the owner (addCoin).

# Name shown in the explorer (unique on the whole chain)
NAMESPACE=bwsc-limit

# One line for the explorer
DESCRIPTION=BWSC limit orders: put up one coin for another at your price; anyone can fill it

# Fee of every first coin, in basis points of what the taker receives (10 = 0.1%, at most 500)
FEE_BPS=10
