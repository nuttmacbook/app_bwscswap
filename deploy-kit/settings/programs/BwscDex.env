# ==================================================================== BwscDex (deploy-kit/bwsc/BwscDex.js), test chain only
# On your real chain: deploy-kit/bwsc/inputs/3-BwscDex.json.

# Fee of new pairs in basis points (30 = 0.30%), 0 to 100. Goes to the pair's liquidity providers.
FEE_BPS=30

# true = anyone may create a pair; false = only the owner (the owner can change it later)
OPEN_PAIRS=false

NAMESPACE=bwsc-dex
DESCRIPTION=BWSC exchange: every pair in one program, constant product, fees to liquidity providers
