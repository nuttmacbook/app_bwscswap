# ==================================================================== USDT on BWSC (a standard token, deploy-kit/settings/deploy.config.mjs)
# The bridge pays this out when USDT (BSC-USD) is locked on BSC. Lock and release: the whole supply goes to the
# deployer, who adds it to the bridge as liquidity (the test chain does it; on your real chain see deploy-kit/README.md step 10).
# Same decimals as BSC-USD (18), so 1 USDT on BSC = 1 USDT here with no conversion.

NAME=Tether USD
TICKER=USDT
DECIMALS=18
SUPPLY=1000000000
NAMESPACE=usdt
