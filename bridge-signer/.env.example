# ==================================================================== BRIDGE SIGNER (secret part only)
# Copy to bridge-signer/.env on your server. Never commit it. Everything else (chains, node, bridge addresses,
# confirmations, the website's address) is read from settings/config.js — the same file the website uses.

# The key that signs claim totals: the signer wallet of step 0 in deploy-kit/README.md. Its address is the signer you
# gave every bridge when deploying. Whoever has it can sign any total: keep it only on this server.
SIGNER_PRIVATE_KEY=

# The wallet that sends the claims for users and pays their gas (automatic delivery). Optional: empty = the signer
# key above. Recommended: a separate wallet holding only gas money (some BWSC on BWSC, some BNB on BSC, …): it can
# only pay claims to the accounts the signer signed for, so losing it loses only its gas money.
RELAYER_PRIVATE_KEY=

# Where the relayer remembers how far it read every chain (relative to this folder)
STATE_FILE=relayer-state.json

# Port of this service (put HTTPS in front of it, e.g. nginx or Caddy)
PORT=8790

# true when it runs behind a reverse proxy, so the per-IP limit counts callers, not the proxy
TRUST_PROXY=false

# More websites allowed to call it from a browser, besides settings/config.js app.siteUrl (comma separated).
# Running the website on your computer (npm run dev): http://localhost:5173 . Leave empty on the real server.
ALLOW_ORIGINS=

# Where settings/config.js is (relative to this folder). Default: ../settings/config.js
CONFIG_FILE=../settings/config.js
